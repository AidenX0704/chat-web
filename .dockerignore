# 构建上下文排除项：依赖、构建产物、密钥、本地数据

# 依赖与缓存
node_modules
**/node_modules
.pnpm-store
**/.pnpm-store
.cache
**/.cache

# 构建产物（镜像里重新构建）
dist
**/dist
build
**/build

# 版本库与本地杂项
.git
.gitignore
.github
.DS_Store
**/.DS_Store
*.log
tmp

# 密钥：绝不进镜像层
.env
.env.*
server/.env

# 本地数据（数据库与附件）
server/data
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm

# 文档（构建不需要）
docs
