# docker compose 部署参数：复制成 .env 后 compose 会自动读取（.env 已在 .gitignore 中）
#   cp .env.docker.example .env
# 只影响镜像构建与端口，不改动 server/.env 里的账号、Key 与业务配置。

# 唯一对外端口（浏览器访问 http://<服务器IP>:8090）
# 后端 8787 只在 compose 网络内部，不对外映射
WEB_PORT=8090
# 前面还有宿主 nginx / SLB 时改成 127.0.0.1：8090 就只对本机可达，由外层做 HTTPS
WEB_BIND=0.0.0.0

# 基础镜像。直连 Docker Hub 就行时保持默认；
# 境内拉不动（registry-1.docker.io i/o timeout）时改成镜像站前缀，两行都换：
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
NODE_IMAGE=node:22-bookworm-slim
NGINX_IMAGE=nginx:1.27-alpine

# pnpm 源，境内用 npmmirror
NPM_REGISTRY=https://registry.npmmirror.com

# 装 python3/make/g++（better-sqlite3 源码编译兜底）时用的 Debian 镜像站
DEBIAN_MIRROR=mirrors.aliyun.com

# 用 http 访问时必须是 false；挂到 HTTPS 域名后改成 true
COOKIE_SECURE=false
