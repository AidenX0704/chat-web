# ---- 运行环境 ----
NODE_ENV=production
# 前面有 nginx / Caddy 时建议只监听回环地址，由反向代理对外提供 HTTPS
HOST=127.0.0.1
PORT=8787
# 反向代理后面要拿到真实客户端 IP，必须打开；直连时保持 false
TRUST_PROXY=true
LOG_LEVEL=info

# ---- 数据 ----
# SQLite 单文件；放在独立数据盘上，并纳入备份
DATABASE_PATH=./data/chat-personal.sqlite
# 附件原件目录（按用户分目录存放）
DATA_DIR=./data/files
# 单个会话正文上限（MB，含全部分支消息）
CHAT_MAX_MB=8
# 单账号会话数量上限
CHATS_MAX_PER_USER=5000
# 单个附件大小上限（MB），与前端上传限制对齐
FILE_MAX_MB=64
# 单账号附件总配额（MB）
FILES_QUOTA_MB=2048

# ---- 跨域 ----
# 前后端同源部署时留空（默认拒绝跨域）；分站部署时填前端来源，逗号分隔
CORS_ORIGINS=

# ---- 会话 Cookie ----
COOKIE_NAME=chat_session
# 必须是 HTTPS，公网部署务必 true
COOKIE_SECURE=true
# 前后端同站：lax；不同站：none（同时需要 CORS_ORIGINS）
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# 登录态绝对有效期 / 空闲有效期（天）
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=14
# 一个账号最多同时在线的设备数，超出时淘汰最久未使用的一台
MAX_SESSIONS_PER_USER=10

# ---- 个人账号（唯一登录凭据） ----
# 服务端不开放注册，只认这里配置的这一个账号；改完重启生效。下面是占位值，部署前请改成自己的用户名。
# 用户名不区分大小写；口令请用长且随机的字符串（≥ 12 位），不要写进仓库。
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-to-a-long-random-passphrase

# ---- 暴力破解防护 ----
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_SECONDS=60

# ---- 未登录访客额度 ----
# 未登录也能先聊几句：按客户端 IP 每天限量，写进数据库，重启不清零。
# 设成 0 表示关闭访客对话（未登录必须登录才能用）。
GUEST_DAILY_MESSAGES=10

# ---- 上游 API 与聊天代理 ----
DEEPSEEK_ORIGIN=https://api.deepseek.com
# 只有服务端持有；不要写进前端构建配置
DEEPSEEK_API_KEY=
# 单个用户同时进行的代理请求数
PROXY_MAX_CONCURRENT_PER_USER=8
# 附件上传的请求体上限（MB）
PROXY_MAX_BODY_MB=100
