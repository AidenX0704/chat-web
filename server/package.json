{
  "name": "chat-web-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "chat-web 后端服务（可选）：单账号登录、会话与附件同步、DeepSeek API 代理",
  "scripts": {
    "dev": "tsx watch --include .env src/main.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "type": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "bench": "tsx scripts/bench-concurrency.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
